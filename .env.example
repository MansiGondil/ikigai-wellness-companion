# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- Chat model (any OpenAI-compatible provider) ---
# API key for your chat provider. If left blank, OPENAI_API_KEY is used instead.
LLM_API_KEY=your-api-key-here
# Provider endpoint. Leave blank to use OpenAI's default endpoint.
# Example: https://api.your-provider.com/v1
LLM_BASE_URL=
# Model name as your provider spells it. Leave blank to use gpt-4o-mini.
LLM_MODEL=gpt-4o-mini
# Only for reasoning models (e.g. openai/gpt-oss-120b). Leave commented out otherwise.
# LLM_REASONING_EFFORT=low

# --- OpenAI (still required at startup, and used for meme images) ---
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_ORG=your-org-id
